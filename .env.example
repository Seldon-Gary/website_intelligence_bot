# Скопируй в .env и заполни. Файл .env в .gitignore — в репозиторий не попадает.

# --- Обязательное ---
BOT_TOKEN=

# Ключ ProxyAPI (https://proxyapi.ru). Работает и обычный ключ Anthropic —
# тогда ANTHROPIC_BASE_URL надо оставить пустым.
ANTHROPIC_API_KEY=

# Через какой хост ходить к Claude.
# ProxyAPI:               https://api.proxyapi.ru/anthropic
# Прямой Anthropic API:   оставить пустым
ANTHROPIC_BASE_URL=https://api.proxyapi.ru/anthropic

# --- Прокси ---
# Локальный прокси для Telegram и браузера Playwright.
# Пусто = работаем напрямую.
# Примеры: socks5://127.0.0.1:1080  |  http://127.0.0.1:8080
PROXY_URL=

# К ProxyAPI ходим напрямую — он сам решает вопрос доступа,
# гнать его ещё и через локальный прокси не нужно. Оставь false.
ANTHROPIC_VIA_PROXY=false

# --- Внутреннее ---
API_HOST=127.0.0.1
API_PORT=8000
# Адрес API для бота. Локальный трафик, через прокси НЕ идёт.
API_BASE_URL=http://127.0.0.1:8000

# --- Агент ---
# Sonnet 5 достаточно для чтения лендинга и заметно дешевле Opus.
MODEL=claude-sonnet-5
# Глубина рассуждений: low | medium | high | xhigh | max.
# medium — разумный баланс для этой задачи.
EFFORT=medium
MAX_PAGES_PER_SCAN=4

# Ставки за миллион токенов — посмотри в кабинете ProxyAPI, у него свой прайс.
# Оставишь нули — в логах будут только токены, без цены.
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0
